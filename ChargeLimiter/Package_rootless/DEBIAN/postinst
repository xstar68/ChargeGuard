#!/bin/sh

DAEMON_BIN="/var/jb/usr/libexec/ChargeGuardDaemon"
DAEMON_PLIST="/var/jb/Library/LaunchDaemons/com.chargeguard.plist"
CACHE1="/var/jb/var/mobile/Library/Preferences/com.chargeguard.containerpath"
CACHE2="/var/mobile/Library/Preferences/com.chargeguard.containerpath"

# 共享配置数据的逻辑路径。这里特意用变量间接传递，避免在 roothide 打包转换
# (rewrite_roothide_maintainer_script) 时被 sed 改写成 /rootfs/var/... 的物理
# 路径。运行时再通过 jbroot 解析为真实物理路径。
DATA_DIR_LOGICAL="/var/mobile/ChargeGuard"

resolve_jbroot() {
    for cmd in /usr/bin/jbroot /var/jb/usr/bin/jbroot jbroot; do
        if command -v "$cmd" >/dev/null 2>&1; then
            rooted="$($cmd /var/mobile/Library/Preferences 2>/dev/null)"
            if [ -n "$rooted" ] && [ "${rooted#/}" != "$rooted" ]; then
                printf '%s' "$rooted"
                return 0
            fi
        elif [ -x "$cmd" ]; then
            rooted="$($cmd /var/mobile/Library/Preferences 2>/dev/null)"
            if [ -n "$rooted" ] && [ "${rooted#/}" != "$rooted" ]; then
                printf '%s' "$rooted"
                return 0
            fi
        fi
    done

    if [ -d /var/jb ]; then
        rooted="$(cd /var/jb 2>/dev/null && pwd -P)"
        if [ -n "$rooted" ] && [ "${rooted#/}" != "$rooted" ]; then
            printf '%s' "$rooted/var/mobile/Library/Preferences"
            return 0
        fi
    fi

    return 1
}

# 解析共享数据目录的真实物理路径（jbroot 根下的对应位置），并以 mobile:mobile
# 校正权限，确保 mobile App 能以原子方式写入 com.chargeguard.plist。
resolve_cl_data_root() {
    for cmd in /usr/bin/jbroot /var/jb/usr/bin/jbroot jbroot; do
        if command -v "$cmd" >/dev/null 2>&1; then
            data_root="$($cmd "$DATA_DIR_LOGICAL" 2>/dev/null)"
            if [ -n "$data_root" ] && [ "${data_root#/}" != "$data_root" ]; then
                printf '%s' "$data_root"
                return 0
            fi
        elif [ -x "$cmd" ]; then
            data_root="$($cmd "$DATA_DIR_LOGICAL" 2>/dev/null)"
            if [ -n "$data_root" ] && [ "${data_root#/}" != "$data_root" ]; then
                printf '%s' "$data_root"
                return 0
            fi
        fi
    done
    return 1
}

repair_shared_data_permissions() {
    if data_root="$(resolve_cl_data_root)" && [ -n "$data_root" ] && [ -d "$data_root" ]; then
        chown mobile:mobile "$data_root"
        chmod 0750 "$data_root"
        conf_path="$data_root/com.chargeguard.plist"
        if [ -e "$conf_path" ]; then
            chown mobile:mobile "$conf_path"
            chmod 0640 "$conf_path"
        fi
    fi
}

CACHE3=""
if JB_PREFS_DIR="$(resolve_jbroot)"; then
    CACHE3="$JB_PREFS_DIR/com.chargeguard.containerpath"
fi

chown root:wheel "$DAEMON_BIN"
chmod +s "$DAEMON_BIN"
killall -9 ChargeLimiter ChargeGuardDaemon 2>/dev/null
rm -f "$CACHE1" "$CACHE2"
[ -n "$CACHE3" ] && rm -f "$CACHE3"

# 在 daemon bootstrap 前修复共享数据目录权限，避免 daemon 重新夺走所有权。
repair_shared_data_permissions
# v3.0 破坏性改名迁移：旧数据目录 -> 新数据目录；新目录缺失或为空时才复制，旧目录绝不删除。
OLD_DATA_DIR="/var/mobile/ChargeLimiter"
NEW_DATA_DIR="/var/mobile/ChargeGuard"
if [ -d "$OLD_DATA_DIR" ] && { [ ! -d "$NEW_DATA_DIR" ] || [ -z "$(ls -A "$NEW_DATA_DIR" 2>/dev/null)" ]; }; then
    mkdir -p "$NEW_DATA_DIR"
    cp -a "$OLD_DATA_DIR"/. "$NEW_DATA_DIR"/ 2>/dev/null || true
fi

# Step 1 修复：旧配置文件改名。旧配置名为 com.chargelimiter.mod.plist，
# 新代码只读 com.chargeguard.plist；旧名文件若已拷过来且新名文件不存在，
# 复制为新名（旧目录本身绝不删除，旧名文件也保留在新目录内作备份）。
if [ -e "$NEW_DATA_DIR/com.chargelimiter.mod.plist" ] && [ ! -e "$NEW_DATA_DIR/com.chargeguard.plist" ]; then
    cp -a "$NEW_DATA_DIR/com.chargelimiter.mod.plist" "$NEW_DATA_DIR/com.chargeguard.plist" 2>/dev/null || true
fi

# Overnight fix: also cover the case where the new dir already exists non-empty
# (daemon logs/db, partial install) without a new-named config — the old config
# lives only in the old dir and the copy block above never ran.
if [ ! -e "$NEW_DATA_DIR/com.chargeguard.plist" ] && [ -e "$OLD_DATA_DIR/com.chargelimiter.mod.plist" ]; then
    cp -a "$OLD_DATA_DIR/com.chargelimiter.mod.plist" "$NEW_DATA_DIR/com.chargeguard.plist" 2>/dev/null || true
fi

# Step 1 修复：复制后再次修复权限（此前只在复制前修过一次，
# 拷进来的旧文件仍是旧属主，mobile 原子替换新配置会失败）。
repair_shared_data_permissions
# Overnight note: migration above uses literal /var/mobile paths while
# repair_shared_data_permissions uses jbroot-resolved paths. Whether those
# coincide depends on whether this script runs inside the jbroot namespace
# (rootless device question, cannot be settled on Linux — see device
# checklist). As a safe belt-and-braces step, also repair the literal dir
# itself so copied files are never left with the wrong owner on either path.
if [ -d "$NEW_DATA_DIR" ]; then
    chown mobile:mobile "$NEW_DATA_DIR" 2>/dev/null || true
    chmod 0750 "$NEW_DATA_DIR" 2>/dev/null || true
    if [ -e "$NEW_DATA_DIR/com.chargeguard.plist" ]; then
        chown mobile:mobile "$NEW_DATA_DIR/com.chargeguard.plist" 2>/dev/null || true
        chmod 0640 "$NEW_DATA_DIR/com.chargeguard.plist" 2>/dev/null || true
    fi
fi

chown root:wheel "$DAEMON_PLIST"
# Step 1 修复：显式停掉旧守护进程作业。只 kill 进程不够，launchd 里已加载的
# 旧 com.chargelimiter.mod 作业会在 kill 后把旧守护进程拉起来。
launchctl bootout system/com.chargelimiter.mod 2>/dev/null
launchctl bootout system /var/jb/Library/LaunchDaemons/com.chargelimiter.mod.plist 2>/dev/null
launchctl bootout system "$DAEMON_PLIST" 2>/dev/null
launchctl bootstrap system "$DAEMON_PLIST" 2>/dev/null || launchctl load "$DAEMON_PLIST" 2>/dev/null

# CLThermalSim 只在 thermalmonitord 启动时注入（Powercuff 同款重载）：升级后必须
# 重启 thermalmonitord 才能换掉内存中的旧版 tweak，否则旧代码继续驻留执行。
killall thermalmonitord 2>/dev/null

# v3.0 deb 版无桌面应用：不做 uicache，设置入口由 PreferenceLoader 加载。

exit 0
